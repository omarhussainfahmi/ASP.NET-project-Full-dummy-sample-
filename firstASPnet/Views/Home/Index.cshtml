@using firstASPnet.models

@{
    string appTitle = "Asp.net Core Demo App";
    Person person = new Person()
    {
        Name = "Omar",
        Birth = Convert.ToDateTime("2003-4-9")
    };
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["appTitle"]</title>
    <meta charset="utf-8" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>

    <h1>Welcome</h1>
    <h2>Hello @person.Name</h2>

    @{
        double age = Math.Round((DateTime.Now - person.Birth).TotalDays / 365);
    }

    <h3>@age years old</h3>

</body>
</html>