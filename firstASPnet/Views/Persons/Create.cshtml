@{
	ViewBag.Title = "Create Person";

}

<a asp-controller= "Persons" asp-action="Index" href="~/persons/index" class="link-hover" >Back to Persons List</a>
<h2>Create Person</h2>

<div class="w-50">
	<form  asp-controller="Persons" asp-action="Create" method="post">
		<div class="form-field flex">
			<div class="w-25">
				<label for="PerosnName" class="form-label pt">Person Name</label>
				<label></label>
			</div>
			<div class="flex-1">
				<input type="text" id="PersonName" name="PersonName" class="form-input"/>
			</div>
		</div>
	</form>
</div>

