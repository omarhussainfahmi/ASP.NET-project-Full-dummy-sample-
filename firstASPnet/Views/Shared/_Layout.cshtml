@using firstASPnet.Controllers
@inject IConfiguration Config
@{
    Layout = null;
    var title = (ViewData["Title"] as string ?? "ASP.NET Core MVC sample") + " | firstASPnet";
    var description = ViewData["Description"] as string ?? "Explore a layered ASP.NET Core MVC learning project with Razor pages and a secure form validation demonstration.";
    var publicUrl = HomeController.PublicUrl(Config);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    @if (publicUrl is null || ViewData["NoIndex"] is true || Context.Response.StatusCode >= 400) { <meta name="robots" content="noindex, nofollow" /> }
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (publicUrl is not null) {
        <meta property="og:image" content="@(publicUrl + "/social-preview.png")" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:url" content="@(publicUrl + Context.Request.Path)" />
        <link rel="canonical" href="@(publicUrl + Context.Request.Path)" />
    }
    <meta property="og:image:alt" content="firstASPnet — ASP.NET Core MVC learning sample" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/StyleSheet.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header><nav aria-label="Main navigation"><a class="brand" href="/" aria-current="@(Context.Request.Path == "/" ? "page" : null)">firstASPnet</a><a href="/company" aria-current="@(Context.Request.Path == "/company" ? "page" : null)">About</a><a href="/demo" aria-current="@(Context.Request.Path == "/demo" ? "page" : null)">Try the demo</a><a href="/contact" aria-current="@(Context.Request.Path == "/contact" ? "page" : null)">Contact</a></nav></header>
    <main id="main" tabindex="-1">@RenderBody()</main>
    <footer><p>ASP.NET Core MVC learning sample · <a href="/privacy">Privacy &amp; cookies</a> · <a href="/terms">Usage terms</a></p><p>No advertising or analytics cookies are used.</p></footer>
    <a class="mobile-contact" href="/contact">Contact the maintainer</a>
    @await RenderSectionAsync("footer_section", required: false)
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
